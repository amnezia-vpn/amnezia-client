#include <QtCore>
#include <QString>
#include <QStringList>

POD TunnelConfig(int proto, QString config, QStringList dnsServers, int killSwitchMode, QStringList allowedDnsServers, int sitesRouteMode, QStringList sites, int appsRouteMode, QStringList apps, int mtu)

class IpcInterface
{
    SLOT( void setLogsEnabled(bool enabled) );
    SLOT( void clearLogs() );

    SLOT( int tunnelUp(const TunnelConfig &config) );
    SLOT( bool tunnelDown() );
    SLOT( bool setKillSwitchMode(int mode) );
    SLOT( bool addKillSwitchAllowedRanges(const QStringList &ranges) );

    SLOT( bool localProxyUp(const QString &config) );
    SLOT( bool localProxyDown() );
    SLOT( bool isLocalProxyRunning() );

    SIGNAL( tunnelStatusChanged(int status) );
};
