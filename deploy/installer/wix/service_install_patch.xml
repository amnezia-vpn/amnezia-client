<?xml version="1.0" encoding="UTF-8"?>
<CPackWiXPatch>
    <CPackWiXFragment Id="CM_CP_FBLinkVPN_service.exe">
        <ServiceInstall
                Id="FBLinkServiceInstall"
                Name="FBLinkVPN-service"
                DisplayName="FBLink VPN Service"
                Description="Service for FBLink VPN"
                Start="auto"
                Type="ownProcess"
                ErrorControl="normal"
                Vital="no">
            <ServiceDependency Id="BFE" />
            <ServiceDependency Id="nsi" />
        </ServiceInstall>
        <ServiceControl
                Id="FBLinkServiceControl"
                Name="FBLinkVPN-service"
                Start="install"
                Stop="both"
                Remove="both"
                Wait="yes" />
        <ServiceControl
                Id="LegacyServiceControlAmneziaVPN"
                Name="AmneziaVPN-service"
                Stop="both"
                Remove="both"
                Wait="no" />
        <ServiceControl
                Id="LegacyServiceControlFBLink"
                Name="FBLink-service"
                Stop="both"
                Remove="both"
                Wait="no" />
        <ServiceControl
                Id="LegacyServiceControlWGTunnelAmnezia"
                Name="AmneziaWGTunnel$AmneziaVPN"
                Stop="both"
                Remove="both"
                Wait="no" />
        <ServiceControl
                Id="LegacyServiceControlWGTunnelFBLink"
                Name="AmneziaWGTunnel$FBLink"
                Stop="both"
                Remove="both"
                Wait="no" />
        <ServiceControl
                Id="LegacyServiceControlSplitTunnelAmnezia"
                Name="AmneziaVPNSplitTunnel"
                Stop="both"
                Remove="both"
                Wait="no" />
        <ServiceControl
                Id="LegacyServiceControlSplitTunnelFBLink"
                Name="FBLinkSplitTunnel"
                Stop="both"
                Remove="both"
                Wait="no" />
    </CPackWiXFragment>
</CPackWiXPatch>
