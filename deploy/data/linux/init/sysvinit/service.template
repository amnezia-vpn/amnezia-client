#!/bin/sh
### BEGIN INIT INFO
# Provides:          @NAME@
# Required-Start:    $network $remote_fs $syslog
# Required-Stop:     $network $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: @DESC@
### END INIT INFO

NAME="@NAME@"
DAEMON="@BIN@"
ARGS="@ARGS@"
PIDFILE="/run/$NAME.pid"
LOGFILE="@LOGDIR@/$NAME.out"

cleanup_amnezia_iptables() {
    for ipt in iptables ip6tables; do
        if ! command -v "$ipt" >/dev/null 2>&1; then
            continue
        fi

        for table in filter nat mangle raw; do
            "$ipt" -t "$table" -L -n >/dev/null 2>&1 || continue

            "$ipt" -t "$table" -S 2>/dev/null | grep -E '\-j amnvpn\.' | while read -r rule; do
                del_rule=$(echo "$rule" | sed 's/^-A/-D/')
                "$ipt" -t "$table" $del_rule 2>/dev/null || true
            done

            "$ipt" -t "$table" -S 2>/dev/null | sed -n 's/^-N \(amnvpn[^ ]*\)$/\1/p' | while read -r chain; do
                "$ipt" -t "$table" -F "$chain" 2>/dev/null || true
                "$ipt" -t "$table" -X "$chain" 2>/dev/null || true
            done
        done
    done
}

start() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "$NAME is already running"
        return 0
    fi
    echo "Starting $NAME"
    mkdir -p "@LOGDIR@"
    case "$NAME" in
        amneziavpn)
            rm -f /tmp/AmneziaVPN* /run/AmneziaVPN* /var/run/AmneziaVPN*
            ;;
    esac

    (
        while true; do
            case "$NAME" in
                amneziavpn)
                    rm -f /tmp/AmneziaVPN* /run/AmneziaVPN* /var/run/AmneziaVPN*
                    ;;
            esac
            "$DAEMON" $ARGS
            sleep 1
        done
    ) >>"$LOGFILE" 2>&1 &
    echo $! > "$PIDFILE"

    sleep 1
    if ! kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "$NAME failed to start, see $LOGFILE" >&2
        rm -f "$PIDFILE"
        return 1
    fi
}

stop() {
    if [ ! -f "$PIDFILE" ]; then
        echo "$NAME is not running"
        return 0
    fi
    PID="$(cat "$PIDFILE")"
    echo "Stopping $NAME"
    kill "$PID" 2>/dev/null || true
    rm -f "$PIDFILE"

    pkill -TERM -f "$DAEMON" 2>/dev/null || true
    i=0
    while pgrep -f "$DAEMON" >/dev/null 2>&1 && [ "$i" -lt 10 ]; do
        sleep 1
        i=$((i + 1))
    done
    pkill -9 -f "$DAEMON" 2>/dev/null || true

    case "$NAME" in
        amneziavpn)
            cleanup_amnezia_iptables
            rm -f /tmp/AmneziaVPN* /run/AmneziaVPN* /var/run/AmneziaVPN*
            ;;
    esac
}

status() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "$NAME is running (watchdog pid $(cat "$PIDFILE"))"
    else
        echo "$NAME is not running"
        return 1
    fi
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; start ;;
    status)  status ;;
    *)       echo "Usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
