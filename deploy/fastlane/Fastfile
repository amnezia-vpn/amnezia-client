def archive_build(app_platform)
  build_app(
    project: "build/AmneziaVPN.xcodeproj",
    scheme: "AmneziaVPN",
    configuration: "Release",
    export_method: "app-store",
    output_directory: "build/#{app_platform}",
    output_name: "AmneziaVPN"
  )
end

def authorize_app_store_connect
  key = ENV.fetch("APPSTORE_CONNECT_PRIVATE_KEY")
  app_store_connect_api_key(
    key_id: ENV.fetch("APPSTORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APPSTORE_CONNECT_ISSUER_ID"),
    key_content: key,
    is_key_content_base64: !key.include?("PRIVATE KEY")
  )
end

platform :ios do
  lane :archive do
    archive_build("ios")
  end

  lane :testflight_upload do
    authorize_app_store_connect
    upload_to_testflight(ipa: "build/ios/AmneziaVPN.ipa", skip_waiting_for_build_processing: true)
  end
end

platform :mac do
  lane :archive do
    archive_build("osx")
  end

  lane :testflight_upload do
    authorize_app_store_connect
    upload_to_testflight(app_platform: "osx", pkg: "build/osx/AmneziaVPN.pkg", skip_waiting_for_build_processing: true)
  end
end

platform :android do
  lane :play_upload do
    upload_to_play_store(
      package_name: "org.amnezia.vpn",
      track: "beta",
      release_status: "draft",
      aab_paths: Dir["../build/android/*_play.aab"].map { |path| File.expand_path(path) },
      json_key_data: ENV.fetch("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"),
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
